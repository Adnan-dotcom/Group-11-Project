# ─────────────────────────────────────────────
#  AuraGen Backend – Environment Variables
#  Copy this file to .env and fill in values.
# ─────────────────────────────────────────────

# Server
PORT=4000
FRONTEND_ORIGIN=http://localhost:3000

# LLM Provider  (openai | azure | ollama)
LLM_PROVIDER=openai

# OpenAI
OPENAI_API_KEY=sk-...
OPENAI_MODEL=gpt-4o-mini       # fast + cheap for demos; swap to gpt-4o for quality

# Azure OpenAI (only if LLM_PROVIDER=azure)
AZURE_OPENAI_API_KEY=
AZURE_OPENAI_ENDPOINT=https://<your-resource>.openai.azure.com/
AZURE_OPENAI_API_DEPLOYMENT_NAME=gpt-4o
AZURE_OPENAI_API_VERSION=2024-02-15-preview

# Ollama (only if LLM_PROVIDER=ollama – runs locally, no key needed)
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3

# LLM behaviour
LLM_TEMPERATURE=0.3            # low = deterministic, good for code-gen
LLM_MAX_TOKENS=2048

# Cache / rate-limit  (simple in-memory cache TTL in seconds)
CACHE_TTL_SECONDS=300
